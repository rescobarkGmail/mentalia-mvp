VITE_APP_ENV=LOCAL

# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google OAuth
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Supabase Edge Function secrets, do not expose as VITE_*.
# Configure with: supabase secrets set KEY=value
# WHATSAPP_ACCESS_TOKEN=YOUR_META_WHATSAPP_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
# WHATSAPP_TEMPLATE_LANGUAGE=es_CL
# WHATSAPP_TEMPLATE_CONFIRMED=reserva_confirmada
# WHATSAPP_TEMPLATE_RESCHEDULED=reserva_reagendada
# WHATSAPP_TEMPLATE_CANCELLED=reserva_cancelada
# WHATSAPP_TEMPLATE_REMINDER_27H=recordatorio_27h
# WHATSAPP_TEMPLATE_REMINDER_60M=recordatorio_60min
# WHATSAPP_REMINDER_27H_MINUTES=1620
# INTERNAL_CRON_SECRET=use-a-long-random-secret-for-scheduler-calls
# REMINDER_LOOKAHEAD_MINUTES=15
